system "sourceant/sourceant#201"
intent "Add parallel discovery and evaluation"
purpose feat "Add parallel discovery and evaluation"

district api "api"
district core "core"
district integrations "integrations"
district models "models"
district plugins "plugins"

service api "src/api" in=api size=1

service api_routes "src/api/routes" in=api
  ~ endpoint ReviewInput
  ~ endpoint run
  + endpoint valid_files
  + endpoint configuration_for
  + endpoint submit_snapshot

service core "src/core" in=core size=1
  ~ function submit
  ~ function parallel_map
  ~ function with_service
  ~ function contribute

service core_analysis "src/core/analysis" in=core
  ~ function unchecked
  ~ function analyzers
  ~ function run
  ~ function supports
  ~ function available
  ~ class AnalyzerCoverage
  ~ class AnalyzerReport
  ~ class AnalyzerFinding

service core_change_context "src/core/change_context" in=core size=1
  ~ function read_change

service core_model "src/core/model" in=core size=1
  ~ function providers_for
  ~ function llm_source
  ~ function provider_for
  ~ function config_for
  + function validate_endpoint
  + class ModelProfile
  + class ProfileCredential

service core_review "src/core/review" in=core size=5
  ~ function reviewer
  ~ function review_orchestrator
  ~ function review_plan_source
  ~ function working_tree_reviewer
  + function value
  + function with_workspace
  + function git
  + function content
  + class _Judgment

service core_review_coverage "src/core/review_coverage" in=core size=1
  ~ function reaches
  ~ function merge
  ~ function attempts

service core_settings "src/core/settings" in=core size=1
  ~ function validate

service integrations_github "src/integrations/github" in=integrations size=1
  ~ function deliver

database models "src/models" in=models size=1
  ~ class CodeReview

service builtin_code_reviewer "src/plugins/builtin/code_reviewer" in=plugins
  ~ function summarize_changes
  ~ function generate_review
  ~ function review
  ~ function _review_once
  ~ function _indexes
  ~ function reviewed

external outside_github "github"

api_routes calls builtin_code_reviewer
api_routes calls core_review
api_routes calls core_settings
builtin_code_reviewer calls core
builtin_code_reviewer calls core_change_context
builtin_code_reviewer calls core_review
builtin_code_reviewer calls core_settings
builtin_code_reviewer calls models
core_analysis calls core
core_model calls core_review
core_review calls core
core_review calls core_review_coverage
core_review calls models
integrations_github calls outside_github

risk 1 at core_change_context.read_change "`complete_diff=True` only removes the truncation marker; the loop above still `break`s at `MAX_DIFF`, so the returned diff is cut short and nothing in it says so." impact=none certainty=possible blast=one
risk 2 at builtin_code_reviewer.generate_review "When the plan is premium and `review.analysis_gate_errors` is unset or 0, `analysis` stays empty, so the analyzer pass never runs: `also_reported` and the ANALYSIS coverage records add no tool findings, and the overview…" impact=none certainty=possible blast=one

test core_review "test_review_orchestration.py"
