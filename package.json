{
  "name": "@sourceant/codetown",
  "version": "0.0.1",
  "description": "Describe software, or a change to it, in a small language and draw it as an animated city.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vocabulary.json": "./vocabulary.json",
    "./three": {
      "types": "./dist/three.d.ts",
      "default": "./dist/three.js"
    }
  },
  "bin": {
    "codetown": "./dist/cli.js"
  },
  "files": [
    "dist",
    "vocabulary.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "vocabulary": "node dist/cli.js words --json > vocabulary.json && { printf '# Vocabulary\\n\\nGenerated by `codetown words` from the registry in `src/vocabulary.ts`. Do not edit by hand.\\n\\n'; node dist/cli.js words; } > VOCABULARY.md"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "25.9.9",
    "@types/three": "0.186.0",
    "three": "0.186.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sourceant/codetown.git"
  },
  "homepage": "https://github.com/sourceant/codetown",
  "peerDependencies": {
    "three": ">=0.170.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
